<?xml version="1.0" encoding="utf-8"?>
<!--
  FilmCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build filmcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.

  FilmCraft Lite (this fork): its own name, publisher, UpgradeCode, component GUID and install
  folder, so it installs next to official FilmCraft instead of upgrading (replacing) it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="FilmCraft Lite"
      Manufacturer="GaneshMacharla"
      Version="$(var.Version)"
      UpgradeCode="B80EC335-E59C-4C5E-BB74-80F1E6FE9938"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="FilmCraft Lite video editor" Manufacturer="GaneshMacharla" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of FilmCraft Lite is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/GaneshMacharla/premierpro" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/GaneshMacharla/premierpro/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/GaneshMacharla/premierpro/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FilmCraft Lite" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FilmCraft Lite" Level="1">
      <ComponentGroupRef Id="FilmcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="FilmcraftApp" Guid="AF61C3AA-8DCC-4A3D-B32A-A8563B08E05E">
        <File Id="FilmcraftExe" Source="$(var.BinDir)\filmcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FilmCraft Lite"
              Description="FilmCraft Lite video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FilmcraftIcon.ico" IconIndex="0" />
        </File>
      </Component>

      <Component Id="FilmcraftCli">
        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\filmcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
